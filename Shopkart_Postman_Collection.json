{
  "info": {
    "_postman_id": "shopkart-api-collection-viva",
    "name": "Shopkart API - Viva Demonstration",
    "description": "Comprehensive Postman collection for demonstrating the Shopkart E-Commerce REST API (Labs 01-06) during viva and evaluations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "sampleProductId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shopKartOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "razorpayOrderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Server Status",
      "item": [
        {
          "name": "Health Check (Root)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          }
        },
        {
          "name": "Server Health Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer & Authentication",
      "item": [
        {
          "name": "1. Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Saketh Kumar\",\n  \"email\": \"saketh.demo@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "register"
              ]
            }
          }
        },
        {
          "name": "2. Login Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"saketh.demo@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "login"
              ]
            }
          }
        },
        {
          "name": "3. Get Customer Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "me"
              ]
            }
          }
        },
        {
          "name": "4. Change Password (Protected)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newSecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "change-password"
              ]
            }
          }
        },
        {
          "name": "5. Logout Customer",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Product Catalog",
      "item": [
        {
          "name": "1. Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.products && res.products.length > 0) {",
                  "    pm.collectionVariables.set('sampleProductId', res.products[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "2. Get Single Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{sampleProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{sampleProductId}}"
              ]
            }
          }
        },
        {
          "name": "3. Search Products by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?search=Keyboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Keyboard"
                }
              ]
            }
          }
        },
        {
          "name": "4. Filter by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?category=Electronics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Electronics"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Wishlist Management (Protected)",
      "item": [
