              "raw": "{{baseUrl}}/cart/{{sampleProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "{{sampleProductId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Orders & Razorpay Checkout (Lab 06)",
      "item": [
        {
          "name": "1. Create Payment Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Aarav Sharma\",\n    \"phone\": \"9876543210\",\n    \"addressLine1\": \"22 MG Road, Koramangala\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/create-payment-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "create-payment-order"
              ]
            }
          }
        },
        {
          "name": "2. Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopKartOrderId\": \"{{shopKartOrderId}}\",\n  \"razorpay_order_id\": \"{{razorpayOrderId}}\",\n  \"razorpay_payment_id\": \"pay_test_sample123\",\n  \"razorpay_signature\": \"sample_hmac_signature\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/verify-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "verify-payment"
              ]
            }
          }
        },
        {
          "name": "3. Get My Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "4. Get Order By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{shopKartOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{shopKartOrderId}}"
              ]
            }
          }
        },
        {
          "name": "5. Update Order Status (Bonus)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
