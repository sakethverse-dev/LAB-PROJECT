# Razorpay Key ID (Safe for client side, never put KEY_SECRET here)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Backend API URL (Leave blank in development for default localhost:5000)
# In production, set to your deployed backend URL (e.g. https://shopkart-backend.onrender.com)
VITE_API_URL=http://localhost:5000
